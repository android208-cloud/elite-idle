{
  "name": "elite-idle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Elite Idle: Elite 1985 в формате капитана-менеджера",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "node --test \"test/**/*.test.ts\"",
    "standalone": "npm run build && node tools/make-standalone.mjs",
    "verify:standalone": "node tools/verify-standalone.mjs && node tools/verify-docking.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
